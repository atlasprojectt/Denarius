# Denarius — environment variables (copy to .env.local, never commit real values)
# .env* is gitignored. Server-only vars must never be prefixed NEXT_PUBLIC_.

# --- Supabase (needed for issue #12: auth + tenant + RLS) ---
# Public: safe in the browser — RLS is what protects the data, not this key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: bypasses RLS (cron crosses tenants). NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Encryption (needed when connectors land, #15/#16) ---
# Encrypts provider Admin keys at rest. 32 bytes, base64 or hex:
#   openssl rand -base64 32
# The single pre-rotation key; it takes the reserved id "legacy" and is the
# only key that opens pre-#75 "v1" blobs. Enough on its own for a fresh setup.
CREDENTIAL_ENCRYPTION_KEY=
# The keyring (#75) — <id>:<key> pairs, comma-separated, ids [a-z0-9_-]{1,16}.
# More than one key may be configured at once: that is what makes a rotation
# windowless (the retired key still reads while the new one writes).
# CREDENTIAL_ENCRYPTION_KEYS=k1:<key>,k2:<key>
# Which id encrypts NEW credentials. Required whenever more than one key is
# configured — nothing guesses, writes fail loudly instead of stranding rows.
# Procedure: docs/backend.md §14.
# CREDENTIAL_ENCRYPTION_KEY_ID=

# --- Dev only, NEVER in production ---
# "1" lets a key starting with sk-fake use the fixture-backed fake OpenAI
# backend (demo/e2e without a real Admin key, pending issue #11).
# ALLOW_FAKE_PROVIDER=

# Set by CI only (#78): makes a database-backed suite that cannot run FAIL
# instead of skipping quietly. Locally, leave it unset — the pure suites must
# stay runnable with no infrastructure at all.
# DENARIUS_REQUIRE_DB_TESTS=1

# Playwright UI/UX audit suite (use a dedicated seeded tenant)
# E2E_BASE_URL=http://127.0.0.1:3000
# E2E_EMAIL=
# E2E_PASSWORD=

# --- LLM narration (needed for engine/digest, #18/#20) ---
# Claude Haiku 4.5 for narration only (numbers are always injected, never generated).
ANTHROPIC_API_KEY=

# --- Transactional email (needed for notifications, #20) ---
RESEND_API_KEY=

# --- Cron protection (needed for daily sync, #17) ---
# Shared secret the Vercel Cron route checks before running.
CRON_SECRET=

# --- Notifications (#20) ---
# Optional overrides; sensible defaults apply when unset.
# Narration model for the weekly digest (default: claude-haiku-4-5).
# NARRATION_MODEL=
# Email sender once a domain is verified on Resend (default: onboarding sender).
# NOTIFY_FROM_EMAIL=
# Deep-link base used inside emails (default: the production URL).
# APP_BASE_URL=
